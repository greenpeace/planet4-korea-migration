{
  "name": "greenpeace/planet4-korea-migration",
  "description": "Greenpeace Planet 4",
  "license": "MIT",
  "require": {
    "greenpeace/planet4-master-theme": "dev-PLANET-8358_test_migration",
    "wpackagist-plugin/query-monitor": "3.*",
    "greenpeace/planet4-child-theme-korea": "1.1.*",
    "greenpeace/planet4-gpea-plugin-blocks": "0.7.*",
    "wpackagist-plugin/classic-editor": "1.*",
    "wpackagist-plugin/shortcode-ui": "0.*"
  },
  "scripts": {
    "install:plugin-wpallexport": "wp plugin install --activate https://storage.googleapis.com/planet4-3rdparty-plugins/wp-all-export.1.5.0.zip",
    "install:plugin-wpallimport": "wp plugin install --activate https://storage.googleapis.com/planet4-3rdparty-plugins/wp-all-import-pro_4.8.5.zip",
    "site:custom": [
      "@install:plugin-wpallexport",
      "@install:plugin-wpallimport"
    ]
  }
}
